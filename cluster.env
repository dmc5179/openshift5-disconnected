# Non-secret settings for the simulated disconnected OpenShift 5 build on AWS.
# Safe to commit. Secrets (AWS credentials, pull secret, mirror CA) live in secrets/.
#
# Sourced by the scripts in scripts/, which set ROOT to the repository root first.

# ---------------------------------------------------------------------------
# OpenShift release
# ---------------------------------------------------------------------------

# Release whose oc / openshift-install the bastion downloads, and the default
# min/max for the mirrored platform release.
OCP_VERSION="5.0.0"

# Update channel mirrored by oc-mirror. stable-5.0 is empty until GA; use
# candidate-5.0 before then. The operator catalog tag (v5.0) is derived from it.
OCP_CHANNEL="candidate-5.0"

# Optional: mirror an upgrade path from this 4.22.z to OCP_VERSION. It is put
# into the SAME 5.x channel as minVersion, never as a second channel:
# OCPBUGS-136257 makes oc-mirror fail when 4.x and 5.x channels are combined.
# Starting below 4.22 needs a separate imageset config and oc-mirror run.
OCP_UPGRADE_FROM=""

# ---------------------------------------------------------------------------
# Target AWS environment
# ---------------------------------------------------------------------------
# Most customers run in AWS GovCloud or the ISO / ISO-B (secret / top secret)
# regions. auto = from the partition of the credentials in secrets/aws.env.
# Set iso or isob in a commercial account to SIMULATE the ISO constraints:
#   - network load balancers have no security groups in ISO; the installer's
#     API NLB uses one, so ISO needs a workaround (AGENTS.md ISO-*)
#   - private cluster only, custom CA bundle for the AWS APIs, custom RHCOS AMI
# Values: auto | commercial | govcloud | iso | isob
TARGET_ENV="auto"

# ISO / ISO-B only (ignored elsewhere and when simulating):
# CA bundle the region's AWS API endpoints are signed with; appended to
# additionalTrustBundle.
AWS_CA_BUNDLE_FILE="${ROOT}/secrets/aws-iso-ca-bundle.pem"
# RHCOS AMI imported into the region (no public RHCOS AMIs in ISO). Leave blank
# elsewhere to use the published one.
RHCOS_AMI_ID=""

# ---------------------------------------------------------------------------
# VPC CloudFormation stack (cloudformation/disconnected_vpc_plus.yaml)
# ---------------------------------------------------------------------------

VPC_STACK_NAME="ocp5-disconnected"
VPC_TEMPLATE="${ROOT:?cluster.env must be sourced with ROOT set}/cloudformation/disconnected_vpc_plus.yaml"

# Must not overlap 100.64.0.0/16 (OVN-Kubernetes). Also used as the
# install-config machineNetwork.
VPC_CIDR="10.0.0.0/16"

# 1-3. One AZ is enough for a lab and keeps the bill down.
VPC_AZ_COUNT="1"

# Subnet size bits (12 = /20 on a /16).
VPC_SUBNET_BITS="12"

# EC2 key pair in the region, for SSH to the bastion and (through it) the
# registry. Its PRIVATE key must be on this machine (SSH_PRIVATE_KEY); the
# deploy script checks the fingerprint, because the bastion-to-registry steps
# need it. Imported from ~/.ssh/id_rsa.pub on 2026-11-03.
EC2_KEY_NAME="ocp5-disconnected"
SSH_PRIVATE_KEY="${HOME}/.ssh/id_rsa"

# Bastion RHEL major version: 9 or 10. Chosen when the stack is created; a
# bastion is never upgraded in place (rebuild the stack to change it). RHEL 10
# becomes a requirement for later releases (e.g. 5.3). The newest Red Hat AMI
# for the region is looked up; set BASTION_AMI_ID to pin one instead.
BASTION_RHEL_VERSION="9"
BASTION_AMI_ID=""

# CIDR allowed to SSH to the bastion. Blank = this machine's public IP /32.
ALLOWED_SSH_CIDR=""

PROXY_INSTANCE_TYPE="t3.large"     # Squid NAT / egress filter
BASTION_INSTANCE_TYPE="t3.large"   # connected side: downloads, oc-mirror to disk
REGISTRY_INSTANCE_TYPE="t3.large"  # disconnected side: mirror-registry (Quay)

# ---------------------------------------------------------------------------
# Cluster (install-config.yaml)
# ---------------------------------------------------------------------------

CLUSTER_NAME="ocp5"

# Leave blank to auto-detect the account's single public Route 53 zone. The
# cluster is private (publish: Internal), so the installer creates its own
# private hosted zone under this domain.
BASE_DOMAIN=""

AWS_CONTROL_PLANE_TYPE="m6i.xlarge"
AWS_CONTROL_PLANE_REPLICAS="3"
AWS_WORKER_TYPE="m6i.xlarge"
AWS_WORKER_REPLICAS="2"

# Internal (default): private cluster - internal load balancers, private hosted
# zone, private subnets only. External puts the API and ingress load balancers
# on the public subnets. Override per run: generate-install-config.sh --publish.
PUBLISH="Internal"

# Cloud credentials for the cluster's operators.
#   Manual (default) + STS: short-lived tokens through an IAM OIDC provider, set
#     up with ccoctl before install (scripts/20-prepare-sts.sh). No long-lived
#     keys in the cluster, and the install host needs no IAM user keys for Mint.
#   Mint: the installer needs IAM user keys; it rejects an EC2 instance role.
#   Passthrough: the cluster reuses the installer's credentials.
CREDENTIALS_MODE="Manual"

# ccoctl (STS). Name prefix for the IAM roles, OIDC provider and its S3 bucket;
# must be unique in the account. The OIDC discovery documents must be readable
# by AWS STS: by default ccoctl uses a public S3 bucket. Set
# CCOCTL_PRIVATE_BUCKET=true for a private bucket behind CloudFront (CloudFront
# is not available in the ISO regions - AGENTS.md ISO-5).
CCOCTL_NAME="${CLUSTER_NAME:-ocp5}-sts"
CCOCTL_PRIVATE_BUCKET="false"

# rhel-10 is the OCP 5 default; rhel-9 for FIPS-validated modules or runc.
OS_IMAGE_STREAM="rhel-10"

# FIPS mode for the cluster: "true" (default for our testing) or "false" (on/off also accepted). Fixed at
# install. "true" requires running openshift-install-fips on a RHEL host booted in
# FIPS mode. Override per run: generate-install-config.sh --fips on|off.
FIPS="true"

# Disable the Insights capability ("Red Hat Lightspeed" health reporting) at
# install. Cannot be undone afterwards.
DISABLE_INSIGHTS="true"

# Day-0 manifests, written by generate-install-config.sh into
# clusters/<name>/day0-manifests/ and added to the install by 40-install-cluster.sh.
#   DISABLE_LIGHTSPEED: console LightspeedButton capability -> Disabled, so the
#     OpenShift Lightspeed AI entry point is hidden from first boot. Not mirroring
#     lightspeed-operator (MIRROR_OPERATORS) keeps the operator uninstallable.
#   DISABLE_DEFAULT_CATALOGS: OperatorHub disableAllDefaultSources, so the default
#     catalogs do not sit in ImagePullBackOff on registry.redhat.io.
#   (DISABLE_DEFAULT_CATALOGS also sets the default OLM v1 ClusterCatalogs to
#   availabilityMode: Unavailable.)
#   TRUST_MIRROR_FOR_IMAGESTREAMS: image.config additionalTrustedCA with the mirror
#     CA, so ImageStream imports trust the mirror instead of falling back to quay.io.
DISABLE_LIGHTSPEED="true"
DISABLE_DEFAULT_CATALOGS="true"
TRUST_MIRROR_FOR_IMAGESTREAMS="true"

# Host that runs openshift-install: registry (private subnet, the disconnected
# side) or bastion. FIPS installs need a FIPS-mode host: run
# scripts/35-enable-fips-host.sh bastion first (default: bastion, because FIPS is on).
INSTALL_HOST="${INSTALL_HOST:-bastion}"

# ---------------------------------------------------------------------------
# Mirror registry and oc-mirror (imageset-config.yaml)
# ---------------------------------------------------------------------------

# Port mirror-registry listens on, and the path oc-mirror pushes under:
#   oc-mirror --v2 ... docker://<registry>:<port>/<MIRROR_NAMESPACE>
MIRROR_REGISTRY_PORT="8443"
MIRROR_NAMESPACE="ocp5"

# mirror-registry's root CA (/opt/quay-root/quay-rootCA/rootCA.pem on the
# registry node). Copy it here before rendering install-config.yaml.
MIRROR_CA_FILE="${ROOT}/secrets/mirror-rootCA.pem"

# Operators to mirror: comma-separated "package" or "package:channel".
# lightspeed-operator is deliberately absent: not mirroring it keeps the
# OpenShift Lightspeed AI features unavailable on the cluster.
MIRROR_OPERATORS=""

# Extra images: comma-separated, fully qualified.
MIRROR_ADDITIONAL_IMAGES="registry.redhat.io/ubi9/ubi:latest"

# Build and push the graph-data image for OpenShift Update Service.
MIRROR_GRAPH="true"

# ---------------------------------------------------------------------------
# Paths and credentials
# ---------------------------------------------------------------------------

CLUSTER_DIR="${ROOT}/clusters/${CLUSTER_NAME}"
PULL_SECRET_FILE="${ROOT}/secrets/pull-secret.json"
# Pull secret the CLUSTER gets: the Red Hat pull secret plus the mirror
# registry's credentials, without cloud.openshift.com. Written by
# scripts/30-fetch-mirror-credentials.sh.
INSTALL_PULL_SECRET_FILE="${ROOT}/secrets/pull-secret-mirror.json"
SSH_KEY_FILE="${HOME}/.ssh/id_rsa.pub"
